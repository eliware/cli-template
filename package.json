{
  "name": "@eliware/cli-template",
  "version": "14.0.0",
  "type": "module",
  "description": "A Node.js CLI template with explicit commands, help, version, and safe execution boundaries.",
  "keywords": [
    "cli-template",
    "cli",
    "nodejs",
    "starter",
    "template"
  ],
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "bin/eliware-cli-template.mjs",
  "bin": {
    "eliware-cli-template": "bin/eliware-cli-template.mjs"
  },
  "files": [
    "src/",
    "docs/",
    "README.md",
    "AGENTS.md",
    "LICENSE",
    "RELEASE_NOTES.md",
    "bin/",
    "specs/",
    "package.json"
  ],
  "scripts": {
    "test": "eliware-test",
    "lint": "eliware-test --lint",
    "audit": "eliware-test --audit",
    "format": "eliware-test --format",
    "format:check": "eliware-test --format-check",
    "pack": "eliware-test --pack"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@eliware/common": "^13.0.0"
  },
  "devDependencies": {
    "@eliware/test": "^13.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.mjs"
    ],
    "collectCoverageFrom": [
      "src/**/*.mjs"
    ],
    "coverageReporters": [
      "text",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "quoteProps": "as-needed",
    "jsxSingleQuote": false,
    "trailingComma": "all",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "always",
    "proseWrap": "preserve",
    "endOfLine": "lf"
  },
  "author": "Eliware <eliware@eliware.org>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eliware/cli-template.git"
  },
  "homepage": "https://github.com/eliware/cli-template#readme",
  "bugs": {
    "url": "https://github.com/eliware/cli-template/issues"
  },
  "eliware": {
    "id": "E-1010",
    "apply": [
      "general",
      "application",
      "cli",
      "npm-published"
    ]
  }
}
